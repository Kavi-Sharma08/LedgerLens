# LedgerLens API configuration
# Copy this file to `.env` and fill in real values. Never commit the real .env.

APP_NAME="LedgerLens API"
ENVIRONMENT=development
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ledgerlens

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Authentication boundary shared secret — MUST match INTERNAL_API_SECRET in
# client/.env.local. FastAPI trusts identity headers only when this matches.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# AI provider (Phase 3). Server-side only — never expose to clients. The Groq
# model is configurable; a sensible default is provided in config.py.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# AI_REQUEST_TIMEOUT_SECONDS=60
# AI_MAX_TOOL_ROUNDS=6
