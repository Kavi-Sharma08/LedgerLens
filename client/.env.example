# ─────────────────────────────────────────────────────────────
# LedgerLens client — local development environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Auth.js session encryption (server-side only). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth (server-side only). Redirect URI to register in Google Cloud:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# MongoDB — used by the Auth.js adapter and registration.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ledgerlens

# Shared secret proving API calls came from Next.js (must match server/.env).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# FastAPI base URL. Public endpoints only (e.g. /api/health badge);
# authenticated calls are proxied same-origin through /api/backend/*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical app URL (metadata/links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
